# ======================= MAIN LOGIC =======================
case "$1" in
  on) wifi_on ;;
  off) wifi_off ;;
  status) wifi_status ;;
  devices) connected_devices ;;
  interfaces) interfaces ;;
  scan) wifi_scan ;;
  connect) wifi_connect "$@" ;;
  ip) local_ip ;;
  publicip) public_ip ;;
  restart) restart_network ;;
  monitor-on) monitor_on ;;
  monitor-off) monitor_off ;;
  capture) capture_traffic "$@" ;;
  ping) ping_test ;;
  dnslookup) dns_lookup "$@" ;;
  traceroute) trace_route "$@" ;;
  portscan) port_scan "$@" ;;
  arpspoof) arp_spoof "$@" ;;
  wpscrack) wps_crack "$@" ;;
  sniff-traffic) sniff_traffic ;;
  ipinfo) ip_info "$@" ;;
  whois) whois_lookup "$@" ;;
  deep-scan) deep_scan "$@" ;;
  discover) discover_devices ;;
  hidden) hidden_files ;;
  suspicious) suspicious_processes ;;
  sshcon) ssh_connections ;;
  macspoof) mac_spoof ;;
  traffic) traffic_stats ;;
  cron) cron_jobs ;;
  vturl) vt_url_scan ;;
  tor) check_tor ;;
  fast-scan) fast_scan "$@" ;;
  stealth-scan) stealth_scan "$@" ;;
  vuln-scan) vuln_scan "$@" ;;
  check) check_deps ;;
  version) echo "ASTU v$VERSION" ;;
  help) help_menu ;;
  "" ) help_menu ;;
  *) echo "❌ Unknown command: $1" >&2; echo "Run 'astu help' to see available commands." >&2; exit 1 ;;
esac
